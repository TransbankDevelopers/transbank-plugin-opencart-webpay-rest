<div class="form-group">
    <label class="col-sm-2 control-label" for="{{ id }}">{{ label }}</label>
    <div class="col-sm-5">
        <select name="{{ id }}" id="{{ id }}" class="form-control">
            {% for order_status in options %}
            <option value="{{ order_status.order_status_id }}" {% if order_status.selected %}selected="selected"{% endif %}>{{ order_status.name }}</option>
            {% endfor %}
        </select>
    </div>
</div>

{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" name="form-webpay_rest" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
                    <i class="fa fa-save"></i>
                </button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
                    <i class="fa fa-reply"></i>
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li>
                    <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
            <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-pencil"></i>{{ text_edit }}
                </h3>
                <button type="button" class="btn btn-danger btn-sm open_commerce_modal" name="button">{{ text_options }}</button>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-webpay_rest" class="form-horizontal">

                    {% include 'extension/payment/webpay_rest_form_select.twig' with {'id': 'payment_webpay_rest_status', 'label': entry_status, 'help': '', 'required': false, 'options': status_options} %}

                    {% include 'extension/payment/webpay_rest_form_select.twig' with {'id': 'payment_webpay_rest_test_mode', 'label': entry_test_mode, 'help': help_test_mode, 'required': true, 'options': test_mode_options} %}

                    {# Commerce Code #}
                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="payment_webpay_rest_commerce_code">
                            <span data-toggle="tooltip" title="{{ help_commerce_code }}"></span> {{entry_commerce_code}}
                        </label>
                        <div class="col-sm-5">
                            <input type="text" name="payment_webpay_rest_commerce_code"
                                   placeholder="{{ webpay_rest_commerce_code_placeholder }}"
                                   id="payment_webpay_rest_commerce_code"
                                   value="{{ payment_webpay_rest_commerce_code|escape }}" class="form-control"
                                   style="font-family:monospace;"/>
                            {% if error_commerce_code %}
                                <div class="text-danger">{{ error_commerce_code }}</div>
                            {% endif %}
                        </div>
                    </div>
                    {# API Key #}
                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="payment_webpay_rest_api_key">
                            <span data-toggle="tooltip" title="{{ help_api_key }}"></span> {{entry_api_key}}
                        </label>
                        <div class="col-sm-5">
                            <input type="text" name="payment_webpay_rest_api_key"
                                   placeholder="{{ webpay_rest_api_key_placeholder }}"
                                   id="payment_webpay_rest_api_key"
                                   value="{{ payment_webpay_rest_api_key|escape }}" class="form-control"
                                   style="font-family:monospace;"/>
                            {% if error_api_key %}
                                <div class="text-danger">{{ error_api_key }}</div>
                            {% endif %}
                        </div>
                    </div>

                    {% include 'extension/payment/webpay_rest_form_order_status_select.twig' with {'id': 'payment_webpay_rest_completed_order_status', 'label': entry_completed_order_status, 'options': order_statuses_completed} %}

                    {% include 'extension/payment/webpay_rest_form_order_status_select.twig' with {'id': 'payment_webpay_rest_rejected_order_status', 'label': entry_rejected_order_status, 'options': order_statuses_rejected} %}

                    {% include 'extension/payment/webpay_rest_form_order_status_select.twig' with {'id': 'payment_webpay_rest_canceled_order_status', 'label': entry_canceled_order_status, 'options': order_statuses_canceled} %}

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="payment_webpay_rest_sort_order">{{ entry_sort_order }}</label>
                        <div class="col-sm-5">
                            <input type="text" name="payment_webpay_rest_sort_order" value="{{ payment_webpay_rest_sort_order|escape }}" placeholder="{{ entry_sort_order }}" id="payment_webpay_rest_sort_order" class="form-control" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{ footer }}

<link href="view/stylesheet/webpay_rest/webpay_rest.css" type="text/css" rel="stylesheet" media="screen" />

{% include 'extension/payment/webpay_rest_modal.twig' %}

{
    "name": "OpenCart Plugin Development Container",
    "dockerComposeFile": ["./docker-compose.yml"],
    "service": "workspace",
    "workspaceFolder": "/workspace",
    "runServices": ["mariadb", "opencart", "workspace"],
    "remoteUser": "root",
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": {
            "label": "OpenCart"
        }
    },
    "shutdownAction": "stopCompose",
    "postCreateCommand": "/usr/local/bin/oc-setup.sh",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached"
    ],
    "features": {
        "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
            "plugins": "git zsh-autosuggestions zsh-syntax-highlighting",
            "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions https://github.com/zsh-users/zsh-syntax-highlighting"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "explorer.confirmDelete": false,
                "editor.bracketPairColorization.enabled": true,
                "editor.guides.bracketPairs": true,
                "editor.autoClosingBrackets": "always",
                "editor.linkedEditing": true,
                "editor.fontLigatures": true,
                "editor.suggestSelection": "first",
                "editor.inlineSuggest.enabled": true,
                "editor.guides.bracketPairsHorizontal": true,
                "editor.unicodeHighlight.invisibleCharacters": false,
                "editor.codeLens": true,
                "editor.formatOnSave": true,
                "editor.rulers": [120],
                "files.insertFinalNewline": true,
                "github.copilot.nextEditSuggestions.enabled": true,
                "git.enableCommitSigning": false,
                "extensions.autoUpdate": false,
                "extensions.autoCheckUpdates": false,
                "extensions.ignoreRecommendations": true,
                "remote.containers.installRecommendedExtensions": false,
                "settingsSync.enabled": false,
                "remote.extensionKind": {
                    "github.copilot": ["ui"],
                    "github.copilot-chat": ["ui"]
                },
                "files.watcherExclude": {
                    "**/vendor/**": true,
                    "**/node_modules/**": true
                },
                "sqltools.connections": [
                    {
                        "name": "OpenCart Mysql",
                        "driver": "MySQL",
                        "server": "mariadb",
                        "port": 3306,
                        "database": "opencart",
                        "username": "opencart",
                        "password": "opencart",
                        "connectionTimeout": 60000,
                        "previewLimit": 50,
                        "group": "Development"
                    }
                ],
                "sqltools.autoOpenSessionFiles": false,
                "sqltools.format": {
                    "language": "sql",
                    "indent": "  "
                },
                "sqltools.defaultExportType": "csv",
                "php.executablePath": "/usr/local/bin/php",
                "php.validate.executablePath": "/usr/local/bin/php",
                "intelephense.files.maxSize": 5000000,
                "intelephense.environment.includePaths": [
                    "/workspace/src/upload/system/library/transbank/vendor"
                ],
                "[php]": {
                    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
                }
            },
            "extensions": [
                "ms-vsliveshare.vsliveshare",
                "github.vscode-github-actions",
                "usernamehw.errorlens",
                "editorconfig.editorconfig",
                "gruntfuggly.todo-tree",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-mysql",
                "DEVSENSE.phptools-vscode",
                "bmewburn.vscode-intelephense-client"
            ]
        }
    }
}
